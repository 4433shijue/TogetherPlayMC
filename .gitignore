# Public source allowlist. Personal installations and historical local QA stay local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE.md
!/CREDITS.md
!/THIRD_PARTY_NOTICES.md
!/package.json
!/package-lock.json
!/start-together.cmd
!/src/
!/web/
!/tests/
!/bridge/
!/companion-mod/
!/desktop/
!/scripts/
!/docs/
!/third-party-licenses/
!/.github/
**/node_modules/
**/.gradle/
**/build/
**/.cache/
**/*.log
**/*.local.json
**/.env*
**/*.sqlite*
**/*.db
**/*.jks
**/*.p12
**/*.pem
/desktop/*
!/desktop/main.cjs
!/desktop/preload.cjs
!/desktop/start.html
!/desktop/start.js
!/desktop/start.css
!/desktop/package.json
!/desktop/package-lock.json
/scripts/*
!/scripts/apply-update.mjs
!/scripts/rollback-update.mjs
!/scripts/local-voice.ps1
!/scripts/prepare-vanilla.mjs
!/scripts/prepare-companion.mjs
!/scripts/prepare-memory-model.mjs
!/scripts/build-companion.mjs
!/scripts/build-orb-faces.mjs
!/scripts/build-dog-ear-fixtures.mjs
!/scripts/package-release.mjs
!/scripts/qa-package.mjs
!/scripts/qa-v016-ui.mjs
!/scripts/third-party-notices.mjs
/docs/*
!/docs/v016-release-notes.md
!/docs/v016-acceptance.md
!/docs/cache-open-source-review.md
!/docs/memory-context-open-source-review.md
!/docs/compatibility.md
!/docs/pack-import-acceptance.md
!/docs/development.md
!/docs/screenshots/
/docs/screenshots/*
!/docs/screenshots/v016/
